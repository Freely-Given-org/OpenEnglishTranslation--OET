\li1
\v 7 Nahshon¦61146 (Amminadav's¦61149 son¦61147) from Yehudah¦61145 \add !(Judah¦61145)\add*,
\li1
\v 8 Netanel¦61152 (Tsuar's¦61155 son¦61153) from Yissakar¦61151 \add !(Issachar¦61151)\add*,
\li1
\v 9 Eliav¦61158 (Helon's¦61161 son¦61159) from Zevulun¦61157,
\li1
\v 10 Elishama¦61166 (Ammihud's¦61169 son¦61163) from Yosef's¦61164 son Efrayim¦61165,
